<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>내 근무 알리미</title>
<!--
  D3 7교시 따라잡기: 바깥 화면. 이 파일은 Apps Script가 아니라 GitHub 저장소에 index.html 이름으로 올립니다(Vercel 또는 GitHub Pages).
  아래 API_URL 따옴표 안에 뒤편(D3_내 근무 알리미 API_Code.gs)을 '모든 사용자'로 새 배포해 받은 …/exec 주소를 붙입니다.
  화면과 칸은 6교시와 같고, google.script.run 대신 exec 주소로 요청을 보내는 부분만 다릅니다.
-->
<script>
  const API_URL = '';   // 예: 'https://script.google.com/macros/s/AKfycb…/exec'
</script>
<style>
  * { box-sizing: border-box; }
  body { font-family: sans-serif; margin: 0; padding: 16px; background: #f4f6fa; color: #1f2937; max-width: 560px; margin-left: auto; margin-right: auto; }
  h1 { font-size: 20px; margin: 0 0 12px; color: #0C4DA2; }
  .tabs { display: flex; gap: 8px; margin-bottom: 12px; }
  .tabs button { flex: 1; margin: 0; padding: 10px; background: #dfe6f1; color: #0C4DA2; }
  .tabs button.on { background: #0C4DA2; color: #fff; }
  label { display: block; font-size: 14px; margin: 12px 0 4px; font-weight: bold; }
  input, select { width: 100%; padding: 10px; font-size: 16px; border: 1px solid #c7cfdb; border-radius: 8px; background: #fff; }
  .row { display: flex; gap: 8px; }
  .row > div { flex: 1; }
  button { width: 100%; margin-top: 20px; padding: 14px; font-size: 16px; border: 0; border-radius: 8px; background: #0C4DA2; color: #fff; }
  button:disabled { background: #9aa8bd; }
  #msg { margin-top: 14px; font-size: 15px; min-height: 22px; }
  .ok { color: #16794a; } .bad { color: #c0392b; }
  .check { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 15px; }
  .check input { width: auto; }
  .sum { display: flex; gap: 8px; margin: 14px 0; }
  .sum div { flex: 1; background: #fff; border-radius: 8px; padding: 10px 4px; text-align: center; font-size: 13px; color: #556; }
  .sum b { display: block; font-size: 22px; color: #0C4DA2; }
  .item { background: #fff; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; font-size: 15px; }
  .item small { color: #667; }
  .tag { font-size: 12px; padding: 2px 6px; border-radius: 6px; background: #fdecea; color: #c0392b; margin-left: 6px; }
  .hide { display: none; }
  .warn { background: #fff5e6; border-radius: 8px; padding: 10px 12px; font-size: 14px; color: #8a4b00; margin-bottom: 12px; }
</style>
</head>
<body>
  <h1>내 근무 알리미</h1>
  <div id="noUrl" class="warn hide">API_URL이 비어 있습니다. 파일 맨 위 API_URL 따옴표 안에 뒤편 exec 주소를 붙여 다시 올립니다.</div>
  <div class="tabs">
    <button id="tabIn" class="on" onclick="showTab('in')">입력</button>
    <button id="tabList" onclick="showTab('list')">목록</button>
  </div>

  <div id="pageIn">
    <label for="date">날짜</label>
    <input type="date" id="date">
    <label for="worker">근무자</label>
    <select id="worker">
      <option value="">고르기</option>
      <option>JH</option><option>SY</option><option>MK</option><option>DW</option>
    </select>
    <div class="row">
      <div><label for="start">시작</label><input type="time" id="start"></div>
      <div><label for="end">끝</label><input type="time" id="end"></div>
    </div>
    <label for="state">상태</label>
    <select id="state">
      <option>확정</option><option>변경</option><option>대타 요청</option>
    </select>
    <label for="memo">메모 (비워도 됨)</label>
    <input type="text" id="memo" maxlength="50">
    <button id="btn" onclick="save()">저장</button>
    <div id="msg"></div>
  </div>

  <div id="pageList" class="hide">
    <label for="fWorker">근무자</label>
    <select id="fWorker" onchange="loadList()">
      <option>전체</option><option selected>JH</option><option>SY</option><option>MK</option><option>DW</option>
    </select>
    <label class="check"><input type="checkbox" id="fWeek" checked onchange="loadList()"> 이번 주만 (월~일)</label>
    <div class="sum">
      <div><b id="sCount">-</b>근무 횟수</div>
      <div><b id="sHours">-</b>시간 합계</div>
      <div><b id="sChanged">-</b>바뀐 근무</div>
    </div>
    <div id="range"></div>
    <div id="list">불러오는 중...</div>
  </div>
<script>
  if (!API_URL) document.getElementById('noUrl').classList.remove('hide');

  function show(text, cls) {
    const m = document.getElementById('msg');
    m.textContent = text;
    m.className = cls;
  }
  function val(id) { return document.getElementById(id).value.trim(); }

  function showTab(t) {
    document.getElementById('pageIn').classList.toggle('hide', t !== 'in');
    document.getElementById('pageList').classList.toggle('hide', t !== 'list');
    document.getElementById('tabIn').classList.toggle('on', t === 'in');
    document.getElementById('tabList').classList.toggle('on', t === 'list');
    if (t === 'list') loadList();
  }

  // 저장: exec 주소로 POST. 본문은 글자(JSON)로만 보내고 특별한 헤더는 붙이지 않습니다(그래야 바깥에서 바로 통합니다).
  function save() {
    const form = { date: val('date'), worker: val('worker'), start: val('start'), end: val('end'), state: val('state'), memo: val('memo') };
    if (!API_URL) return show('API_URL이 비어 있습니다.', 'bad');
    if (!form.date) return show('날짜를 골라 주세요.', 'bad');
    if (!form.worker) return show('근무자를 골라 주세요.', 'bad');
    if (!form.start || !form.end) return show('시작과 끝 시각을 넣어 주세요.', 'bad');
    if (form.end <= form.start) return show('끝 시각이 시작 시각보다 늦어야 합니다.', 'bad');
    const btn = document.getElementById('btn');
    btn.disabled = true;
    show('저장하는 중... (바깥에서 부르면 2~5초 걸립니다)', '');
    fetch(API_URL, { method: 'POST', body: JSON.stringify(form) })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        btn.disabled = false;
        if (res.ok) show(res.message, 'ok'); else show('저장하지 못했습니다: ' + res.error, 'bad');
      })
      .catch(function (e) { btn.disabled = false; show('뒤편에 닿지 못했습니다: ' + e.message + ' (액세스가 모든 사용자인지, API_URL이 마지막 새 배포 주소인지 봅니다)', 'bad'); });
  }

  // 목록: exec 주소로 GET. ?action=list&worker=JH&week=1
  function loadList() {
    const list = document.getElementById('list');
    list.textContent = '불러오는 중...';
    if (!API_URL) { list.textContent = 'API_URL이 비어 있습니다.'; return; }
    const url = API_URL + '?action=list&worker=' + encodeURIComponent(val('fWorker')) + '&week=' + (document.getElementById('fWeek').checked ? '1' : '0');
    fetch(url)
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (!res.ok) { list.textContent = '불러오지 못했습니다: ' + res.error; return; }
        drawList(res.data);
      })
      .catch(function (e) { list.textContent = '뒤편에 닿지 못했습니다: ' + e.message; });
  }

  function drawList(res) {
    document.getElementById('sCount').textContent = res.summary.count;
    document.getElementById('sHours').textContent = res.summary.hours;
    document.getElementById('sChanged').textContent = res.summary.changed;
    document.getElementById('range').textContent = res.from ? res.from + ' ~ ' + res.to : '';
    const list = document.getElementById('list');
    list.textContent = '';
    if (res.rows.length === 0) { list.textContent = '조건에 맞는 근무가 없습니다.'; return; }
    res.rows.forEach(function (r) {
      const div = document.createElement('div');
      div.className = 'item';
      const head = document.createElement('div');
      head.textContent = r.date + '  ' + r.start + '~' + r.end + '  ' + r.worker;
      if (r.state !== '확정') {
        const tag = document.createElement('span');
        tag.className = 'tag';
        tag.textContent = r.state;
        head.appendChild(tag);
      }
      div.appendChild(head);
      if (r.memo) {
        const memo = document.createElement('small');
        memo.textContent = r.memo;
        div.appendChild(memo);
      }
      list.appendChild(div);
    });
  }
</script>
</body>
</html>
